Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMyIsInJvbGUiOiJwdWJsaWMiLCJ0eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzg5Mzc2Nzg4fQ.ATlCfcm0d6vLwbVhH3whCqBH4V81KB-OIkodFZtMc10
Content-Type: application/json

{
  "current_password":"111111",
  "new_password":"123456"
}

