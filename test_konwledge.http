@baseUrl = http://127.0.0.1:8000
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxNCIsInJvbGUiOiJhZG1pbiIsInR5cGUiOiJhY2Nlc3MiLCJleHAiOjE3ODk0NjMyODh9.Z8DF1X4xgwiT-di2J5P-O-xgRBFQhBvQ00jkUMrEGkg
@publicToken = 用户token
@publicUserId = 13
### 核对管理员身份
GET {{baseUrl}}/auth/me
Authorization: Bearer {{adminToken}}
### 核对普通用户身份
GET {{baseUrl}}/auth/me
Authorization: Bearer {{publicToken}}


### 上传企业制度文件
POST {{baseUrl}}/knowledge/documents
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=KnowledgeBoundary

--KnowledgeBoundary
Content-Disposition: form-data; name="visibility"

public
--KnowledgeBoundary
Content-Disposition: form-data; name="file"; filename="明川科技员工日常办公与业务管理制度.md"
Content-Type: text/markdown; charset=utf-8

< ./data/samples/明川科技员工日常办公与业务管理制度.md
--KnowledgeBoundary--
